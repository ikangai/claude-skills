#!/usr/bin/env python3
"""Unified model dispatch: Claude tiers, local LM Studio models, and OpenRouter.

Usage:
  llm --model haiku "Classify this: ..."
  echo "long input" | llm --model qwen/qwen3-coder-30b --system "You extract JSON."
  llm --model or:z-ai/glm-4.7-flash "..."         # OpenRouter (note the or: prefix)
  llm --model or:openai/gpt-oss-120b:free "..."   # OpenRouter free variant
  llm --model sonnet --json "..."        # JSON envelope with latency/tokens/cost
  llm --list                             # show available models

Routing: Claude tiers (fable, opus, sonnet, haiku) via `claude -p` headless mode;
`or:`-prefixed ids via OpenRouter (needs OPENROUTER_API_KEY; costs real money, so
the prefix is an explicit opt-in — cost is reported in the --json envelope);
anything else via LM Studio's OpenAI-compatible API (default http://localhost:1234,
override with LMSTUDIO_BASE_URL). Exit code 0 on success.
"""
import argparse
import json
import os
import subprocess
import sys
import time
import urllib.error
import urllib.request

CLAUDE_TIERS = {"fable", "opus", "sonnet", "haiku"}
LMSTUDIO = os.environ.get("LMSTUDIO_BASE_URL", "http://localhost:1234")
OPENROUTER = os.environ.get("OPENROUTER_BASE_URL", "https://openrouter.ai/api/v1")


def list_models():
    print("claude tiers: " + ", ".join(sorted(CLAUDE_TIERS)))
    try:
        # v0 API exposes load state; loaded models respond instantly,
        # not-loaded ones JIT-load (seconds to minutes) or fail on memory guardrails
        with urllib.request.urlopen(f"{LMSTUDIO}/api/v0/models", timeout=5) as r:
            data = json.load(r)
        print("local (LM Studio):")
        for m in data.get("data", []):
            if "embed" in m.get("id", ""):
                continue
            state = m.get("state", "?")
            mark = "LOADED" if state == "loaded" else "not loaded"
            print(f"  {m['id']:<55} [{mark}] ctx={m.get('max_context_length', '?')}")
    except Exception:
        try:
            with urllib.request.urlopen(f"{LMSTUDIO}/v1/models", timeout=5) as r:
                data = json.load(r)
            local = [m["id"] for m in data.get("data", []) if "embed" not in m["id"]]
            print("local (LM Studio): " + ", ".join(local))
        except Exception as e:
            print(f"local (LM Studio): unavailable ({e})", file=sys.stderr)
    if os.environ.get("OPENROUTER_API_KEY"):
        print("openrouter: key set — use or:<vendor>/<model> ids "
              "(curated registry: references/openrouter-models.json)")
    else:
        print("openrouter: OPENROUTER_API_KEY not set — or: ids unavailable "
              "(export it in your shell profile to enable)")


def call_claude(model, prompt, system, max_tokens, timeout):
    cmd = ["claude", "-p", "--model", model, "--output-format", "json",
           "--no-session-persistence", "--tools", ""]
    if system:
        cmd += ["--system-prompt", system]
    t0 = time.time()
    proc = subprocess.run(cmd, input=prompt, capture_output=True, text=True, timeout=timeout)
    latency_ms = int((time.time() - t0) * 1000)
    if proc.returncode != 0:
        raise RuntimeError(f"claude -p failed (rc={proc.returncode}): {proc.stderr.strip()[:500]}")
    data = json.loads(proc.stdout)
    usage = data.get("usage", {})
    return {
        "model": model,
        "text": data.get("result", ""),
        "latency_ms": data.get("duration_ms", latency_ms),
        "tokens_in": usage.get("input_tokens", 0) + usage.get("cache_read_input_tokens", 0)
                     + usage.get("cache_creation_input_tokens", 0),
        "tokens_out": usage.get("output_tokens", 0),
        "cost_usd": data.get("total_cost_usd", 0.0),
        "backend": "claude-cli",
    }


def _openai_chat(url, headers, model, prompt, system, max_tokens, timeout,
                 temperature, extra_body=None):
    messages = ([{"role": "system", "content": system}] if system else []) + \
               [{"role": "user", "content": prompt}]
    payload = {"model": model, "messages": messages,
               "max_tokens": max_tokens, "temperature": temperature}
    if extra_body:
        payload.update(extra_body)
    req = urllib.request.Request(url, data=json.dumps(payload).encode(),
                                 headers={"Content-Type": "application/json", **headers})
    t0 = time.time()
    try:
        with urllib.request.urlopen(req, timeout=timeout) as r:
            data = json.load(r)
    except urllib.error.HTTPError as e:
        detail = e.read().decode(errors="replace")[:400]
        try:
            detail = json.loads(detail).get("error", {}).get("message", detail)
        except (json.JSONDecodeError, AttributeError):
            pass
        raise RuntimeError(f"HTTP {e.code}: {detail}") from None
    latency_ms = int((time.time() - t0) * 1000)
    if "error" in data:  # OpenRouter can return 200 with an error body
        raise RuntimeError(str(data["error"])[:300])
    msg = data["choices"][0]["message"]
    usage = data.get("usage", {})
    return {
        "text": msg.get("content", "") or "",
        "latency_ms": latency_ms,
        "tokens_in": usage.get("prompt_tokens", 0),
        "tokens_out": usage.get("completion_tokens", 0),
        "cost_usd": float(usage.get("cost", 0.0)),  # OpenRouter usage accounting; 0 for LM Studio
    }


def call_local(model, prompt, system, max_tokens, timeout, temperature):
    result = _openai_chat(f"{LMSTUDIO}/v1/chat/completions", {}, model, prompt,
                          system, max_tokens, timeout, temperature)
    return {"model": model, "backend": "lmstudio", **result}


def call_openrouter(model, prompt, system, max_tokens, timeout, temperature):
    key = os.environ.get("OPENROUTER_API_KEY")
    if not key:
        raise RuntimeError("OPENROUTER_API_KEY not set")
    # Reasoning models count thinking tokens against max_tokens; a tight output
    # budget gets fully consumed by reasoning -> empty content (measured: glm-4.7-flash
    # and gpt-oss-120b returned "" at max_tokens<=500). Add headroom on top of the
    # caller's intended output budget; override via OR_REASONING_HEADROOM=0.
    headroom = int(os.environ.get("OR_REASONING_HEADROOM", 2048))
    result = _openai_chat(
        f"{OPENROUTER}/chat/completions", {"Authorization": f"Bearer {key}"},
        model, prompt, system, max_tokens + headroom, timeout, temperature,
        extra_body={"usage": {"include": True}})  # returns real cost in usage.cost
    return {"model": f"or:{model}", "backend": "openrouter", **result}


def main():
    ap = argparse.ArgumentParser(description=__doc__, formatter_class=argparse.RawDescriptionHelpFormatter)
    ap.add_argument("prompt", nargs="?", help="prompt text (or pipe via stdin)")
    ap.add_argument("--model", "-m", default="haiku")
    ap.add_argument("--system", "-s", default=None)
    ap.add_argument("--max-tokens", type=int, default=4096)
    ap.add_argument("--temperature", type=float, default=0.2, help="local models only")
    ap.add_argument("--timeout", type=int, default=300)
    ap.add_argument("--json", action="store_true", help="emit JSON envelope instead of plain text")
    ap.add_argument("--list", action="store_true", help="list available models")
    args = ap.parse_args()

    if args.list:
        list_models()
        return

    prompt = args.prompt if args.prompt else sys.stdin.read()
    if not prompt.strip():
        sys.exit("error: empty prompt")

    try:
        if args.model in CLAUDE_TIERS:
            result = call_claude(args.model, prompt, args.system, args.max_tokens, args.timeout)
        elif args.model.startswith("or:"):
            result = call_openrouter(args.model[3:], prompt, args.system, args.max_tokens,
                                     args.timeout, args.temperature)
        else:
            result = call_local(args.model, prompt, args.system, args.max_tokens,
                                args.timeout, args.temperature)
    except (subprocess.TimeoutExpired, TimeoutError):
        # socket timeouts from urllib are raw TimeoutError, NOT URLError subclasses
        sys.exit(f"error: {args.model} timed out after {args.timeout}s")
    except (urllib.error.URLError, RuntimeError, KeyError, IndexError,
            json.JSONDecodeError, FileNotFoundError) as e:
        sys.exit(f"error: {args.model}: {e}")

    if args.json:
        print(json.dumps(result, ensure_ascii=False))
    else:
        print(result["text"])


if __name__ == "__main__":
    main()
